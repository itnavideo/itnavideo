# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build
/public/renders/
/public/cache/
/public/uploads/
/public/local-uploads/
/public/assets/asset-embeddings.json
/logs/
/.sandbox/
/.deploy/
/local-private/
/models/
/outputs/

# Local Codex/dev session logs
.codex-*.log
.tmp/
visual-audit/
sticker-previews/
public/test-videos/
itnavideo-indexing-tracker.xlsx
nul
*.bak

# Runtime render pipeline workspaces
/raw_assets/**
/processed_assets/**
/final_output/**
/render_logs/**
!/raw_assets/**/
!/processed_assets/**/
!/final_output/**/
!/render_logs/**/
!/raw_assets/**/.gitkeep
!/processed_assets/**/.gitkeep
!/final_output/**/.gitkeep
!/render_logs/**/.gitkeep

# Misc
.DS_Store
*.pem
*.lcov
.eslintcache

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log

# Python cache
__pycache__/
*.py[cod]

# --- ENV FILES (CRITICAL SECURITY) ---
# Ye sari files GitHub par nahi jayengi
.env
.env.local
.env.development
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Database & Secrets
*.db
*.sqlite
auth_key.json
firebase-adminsdk.json
gcp-credentials.json
*gcp*.json

# Except .env.example (Sirf placeholder values ke liye)
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini

# Local Vercel env pulls - never commit
.env.production.check
.env.production.check2
.env.production.fix
.env.production.verify
.env.vercel-check
.env*.local

# Reference videos (large files, internal only)
docs/references/shorts/
docs/references/long-form/
docs/references/keyframes/

# Sample videos for review (not for deployment)
__samples/

# Temporary and scratch files
/scratch/

.vercel
.vercel-itnavideo/
.env*.local


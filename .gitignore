# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js
/.next/
/out/

# Production
/build
/public/renders/
/public/cache/
/public/uploads/
/logs/
/.sandbox/

# Runtime render pipeline workspaces
/raw_assets/**
/processed_assets/**
/final_output/**
/render_logs/**
!/raw_assets/**/
!/processed_assets/**/
!/final_output/**/
!/render_logs/**/
!/raw_assets/**/.gitkeep
!/processed_assets/**/.gitkeep
!/final_output/**/.gitkeep
!/render_logs/**/.gitkeep

# Misc
.DS_Store
*.pem
*.lcov
.eslintcache

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
firebase-debug.log

# Python cache
__pycache__/
*.py[cod]

# --- ENV FILES (CRITICAL SECURITY) ---
# Ye sari files GitHub par nahi jayengi
.env
.env.local
.env.development
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# Database & Secrets
*.db
*.sqlite
auth_key.json
firebase-adminsdk.json

# Except .env.example (Sirf placeholder values ke liye)
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# OS specific files
Thumbs.db
ehthumbs.db
Desktop.ini

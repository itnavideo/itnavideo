# Itnavideo environment template
# Keep secrets out of git. .env.local is intentionally not tracked.

# ─── App URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.itnavideo.com
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
PORT=3000

# ─── Admin Panel ──────────────────────────────────────────────
ADMIN_API_SECRET=
ADMIN_PASSWORD=
ADMIN_USERNAME=

# ─── Supabase Auth & Database ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Razorpay Checkout (INR & International Cards) ────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# ─── Speech Transcription & AI Providers ───────────────────────
PEXELS_API_KEY=
# Primary transcription engine: Groq Whisper Cloud API (ultra-fast, millisecond word timestamps)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
PREFERRED_TRANSCRIPTION_PROVIDER=groq
AI_TRANSCRIPTION_PROVIDER=groq

# Mandatory transcription fallback & scene planning: Google Gemini 2.0 Flash (asia-south1)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
AI_FALLBACK_PROVIDER=gemini

# Google Cloud Project (asia-south1 Mumbai - strictly for AI APIs)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_LOCATION=asia-south1

# OpenAI (Paused - Key Expired)
OPENAI_API_KEY=
AI_JSON_PROVIDER=groq
AI_TIMELINE_PROVIDER=groq

# ─── AWS S3 & Remotion Lambda Rendering (us-east-1 Mumbai) ────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ASSET_BUCKET=
AWS_ASSET_REGION=us-east-1

REMOTION_AWS_REGION=us-east-1
REMOTION_BUCKET_NAME=
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_SITE_NAME=itnavideo-render-30fps
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_CONCURRENCY=6
REMOTION_LAMBDA_USE_FRAMES_PER_LAMBDA=true
REMOTION_LAMBDA_MEMORY_MB=3008
REMOTION_LAMBDA_TIMEOUT_SECONDS=900
REMOTION_LAMBDA_DISK_MB=2048

# ─── Cloudinary (Website Images, UI Graphics & Demo Videos) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── Master Video Duration Limits & Processing Guardrails ─────
# 9:16 Shorts/Reels max: 180s (3m) | 16:9 YouTube max: 720s (12m) | Long Video to Clips input: 10,800s (3h)
PLANNING_MEDIA_MAX_SECONDS=720
PREPROCESS_MEDIA_MAX_SECONDS=720
TRANSCRIPTION_MAX_SECONDS=720
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_UPLOAD_SIZE_MB=500
MAX_AUDIO_SIZE_MB=100
MAX_AUDIO_DURATION_SEC=10800
CLEAN_TRANSCRIPT_AUDIO=1

# ─── Vercel Deploy Token ──────────────────────────────────────
VERCEL_TOKEN=

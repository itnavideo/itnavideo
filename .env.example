# Itnavideo environment template
# Keep secrets out of git. .env.local is intentionally not tracked.

# App
NEXT_PUBLIC_SITE_URL=https://www.itnavideo.com
NEXT_PUBLIC_API_BASE_URL=
PORT=3000

# Supabase auth/data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay checkout (INR; domestic + enabled international cards)
# KEY_SECRET must stay server-side. NEXT_PUBLIC key is optional because
# the create-order endpoint can safely return KEY_ID to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Admin
ADMIN_API_KEY=
FOUNDER_TEST_EMAILS=

# AI providers
# Groq handles transcription and cheap pre-processing.
# OpenAI handles one consolidated planning/decision call per render.
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AI_PRIMARY_PROVIDER=openai
AI_TRANSCRIPTION_PROVIDER=groq
AI_FALLBACK_PROVIDER=groq
OPENAI_MAX_CALLS_PER_RENDER=1

# Media preprocessing
# Prefer a full FFmpeg binary for audio cleanup/noise reduction. If blank,
# scripts fall back to system PATH, then Remotion's bundled FFmpeg.
FFMPEG_PATH=
PREPROCESS_MEDIA_MAX_SECONDS=60
CLEAN_TRANSCRIPT_AUDIO=1
AUDIO_CLEANUP_FILTER=highpass=f=80,lowpass=f=12000,afftdn=nf=-25,loudnorm=I=-16:TP=-1.5:LRA=11
AUDIO_CLEANUP_FALLBACK_FILTER=loudnorm=I=-16:TP=-1.5:LRA=11

# AWS Lambda rendering
# Local testing still uses npm run reel:render. Production rendering should use
# Remotion Lambda so EC2 does not stay online while no one is rendering.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_SITE_NAME=itnavideo-facefocus-reel
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_MEMORY_MB=3008
REMOTION_LAMBDA_TIMEOUT_SECONDS=600
REMOTION_LAMBDA_DISK_MB=2048
REMOTION_LAMBDA_LOG_RETENTION_DAYS=1
REMOTION_LAMBDA_PRIVACY=private
REMOTION_LAMBDA_DELETE_AFTER=3-days
REMOTION_LAMBDA_CONCURRENCY=8
S3_UPLOAD_ALLOWED_ORIGINS=

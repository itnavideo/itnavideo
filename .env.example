# Itnavideo environment template
# Keep secrets out of git. .env.local is intentionally not tracked.

# App
NEXT_PUBLIC_SITE_URL=https://www.itnavideo.com
NEXT_PUBLIC_API_BASE_URL=
PORT=3000

# Supabase auth/data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay checkout (INR; domestic + enabled international cards)
# KEY_SECRET must stay server-side. NEXT_PUBLIC key is optional because
# the create-order endpoint can safely return KEY_ID to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=

# Admin
ADMIN_API_KEY=
FOUNDER_TEST_EMAILS=

# AI providers
# Groq handles transcription and cheap pre-processing.
# OpenAI handles one consolidated planning/decision call per render.
# Gemini handles Auto Draw scene planning (whiteboard template).
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
OPENAI_TRANSCRIPTION_MODEL=whisper-1
AI_PRIMARY_PROVIDER=openai
AI_TRANSCRIPTION_PROVIDER=groq
AI_FALLBACK_PROVIDER=groq
OPENAI_MAX_CALLS_PER_RENDER=1

# Media preprocessing
# Prefer a full FFmpeg binary for audio cleanup/noise reduction. If blank,
# scripts fall back to system PATH, then Remotion's bundled FFmpeg.
FFMPEG_PATH=
PREPROCESS_MEDIA_MAX_SECONDS=60
CLEAN_TRANSCRIPT_AUDIO=1
AUDIO_CLEANUP_FILTER=highpass=f=80,lowpass=f=12000,afftdn=nf=-25,loudnorm=I=-16:TP=-1.5:LRA=11
AUDIO_CLEANUP_FALLBACK_FILTER=loudnorm=I=-16:TP=-1.5:LRA=11

# Creator Background Replace
# Vercel should stay light: set only CREATOR_BG_REPLACE_WORKER_URL there.
# The Python/FFmpeg variables belong on the AWS worker host/container.
CREATOR_BG_REPLACE_WORKER_URL=
CREATOR_BG_REPLACE_WORKER_HEALTH_URL=
CREATOR_BG_REPLACE_WORKER_SECRET=
CREATOR_BG_REPLACE_PYTHON=
PYTHON_PATH=
CREATOR_BG_REPLACE_MAX_SECONDS=60
NUMBA_CACHE_DIR=.tmp/numba-cache

# AWS Lambda rendering
# Local testing still uses npm run reel:render. Production rendering should use
# Remotion Lambda so EC2 does not stay online while no one is rendering.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_SITE_NAME=itnavideo-facefocus-reel
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_MEMORY_MB=3008
REMOTION_LAMBDA_TIMEOUT_SECONDS=600
REMOTION_LAMBDA_DISK_MB=2048
REMOTION_LAMBDA_LOG_RETENTION_DAYS=1
REMOTION_LAMBDA_PRIVACY=private
REMOTION_LAMBDA_DELETE_AFTER=3-days
REMOTION_LAMBDA_CONCURRENCY=8
S3_UPLOAD_ALLOWED_ORIGINS=

# Google Docs sync (for startup documentation)
# Create a service account at https://console.cloud.google.com/iam-admin/serviceaccounts
# Enable Drive API + Docs API, download JSON key
# Share the Google Drive folder with the service account email
GOOGLE_SERVICE_ACCOUNT_KEY=
# OR inline JSON: GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Indexing API (server-side only)
# Paste minified service account JSON in .env.local / Vercel env.
# If multiline JSON is awkward, use GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON_BASE64 instead.
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON=
GOOGLE_INDEXING_SERVICE_ACCOUNT_JSON_BASE64=
GOOGLE_INDEXING_MAX_URLS_PER_REQUEST=100

# AWS Bedrock DeepSeek (SEPARATE AWS account — not Itnavideo S3/Lambda account)
# Used for AI reel planning: transcript → scene plan, hooks, transitions
# Get API key from: AWS Console → Bedrock → API Keys
BEDROCK_API_KEY_ID=
BEDROCK_API_KEY_SECRET=
BEDROCK_AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.deepseek.r1-v1:0
BEDROCK_MAX_TOKENS=4096

# ═════════════════════════════════════════════════════════════════════════════
# ITNAVIDEO — Environment Variables Template (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# NOTE: Secrets must NEVER be committed to Git.
# ═════════════════════════════════════════════════════════════════════════════

# ─── 1. App & Public URLs ──────────────────────────────────────────────────
PORT=3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api
NEXT_PUBLIC_GA_ID=

# ─── 2. Admin Panel & Founder Access ───────────────────────────────────────
ADMIN_API_SECRET=
ADMIN_PASSWORD=
ADMIN_USERNAME=
FOUNDER_TEST_EMAILS=

# ─── 3. Supabase (Auth, Database & Realtime) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=

# ─── 4. Speech Transcription (Primary: Groq Whisper Cloud API) ─────────────
# Ultra-fast cloud speech-to-text with millisecond word timestamps
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
PREFERRED_TRANSCRIPTION_PROVIDER=groq
AI_TRANSCRIPTION_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini

# ─── 5. Google Cloud & Gemini (AI Planning & Speech Fallback) ───────────────
GEMINI_API_KEY=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# ─── 6. AI Router / Provider Config ─────────────────────────────────────────
AI_JSON_PROVIDER=groq
AI_TIMELINE_PROVIDER=groq

# ─── 7. AWS S3 Storage & Lambda (Video Render Engine — us-east-1) ───────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ASSET_BUCKET=
AWS_ASSET_REGION=us-east-1

REMOTION_AWS_REGION=us-east-1
REMOTION_BUCKET_NAME=
REMOTION_LAMBDA_BUCKET_NAME=
REMOTION_LAMBDA_SITE_NAME=itnavideo-render-30fps
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_LAMBDA_SERVE_URL=
REMOTION_LAMBDA_CONCURRENCY=6
REMOTION_LAMBDA_USE_FRAMES_PER_LAMBDA=true
REMOTION_LAMBDA_MEMORY_MB=3008
REMOTION_LAMBDA_TIMEOUT_SECONDS=900
REMOTION_LAMBDA_DISK_MB=2048

# ─── 8. Razorpay Checkout (Live Indian & International Cards) ───────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── 9. Cloudinary (Website Images, UI Graphics & Demo Videos) ──────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ─── 10. Master Video Duration Limits & Processing Guardrails ───────────────
PLANNING_MEDIA_MAX_SECONDS=720
PREPROCESS_MEDIA_MAX_SECONDS=720
TRANSCRIPTION_MAX_SECONDS=720
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_UPLOAD_SIZE_MB=500
MAX_AUDIO_SIZE_MB=100
MAX_AUDIO_DURATION_SEC=10800
CLEAN_TRANSCRIPT_AUDIO=1

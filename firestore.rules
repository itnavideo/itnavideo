rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Newsletter: Users subscribe (write email), Admin manages
    match /newsletter/{subscriptionId} {
      // Public users sirf apna email "create" (subscribe) kar sakte hain
      allow create: if request.resource.data.email is string 
                   && request.resource.data.email.matches('^[^@]+@[^@]+\\.[^@]+$')
                   && request.resource.data.subscribedAt == request.time;
      
      // Sirf Admin hi subscribers ki list dekh sakta hai
      allow read, update, delete: if request.auth.token.admin == true;
    }

    // Scripts/Templates: Aap likhenge, users sirf padhenge
    match /scripts/{scriptId} {
      // Public users aapke likhe hue scripts padh sakte hain
      allow read: if true;
      
      // Sirf Admin hi naye scripts daal sakta hai ya purane edit kar sakta hai
      allow write: if request.auth.token.admin == true;
    }
    
  }
}

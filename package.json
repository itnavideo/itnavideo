    "start": "node .next/standalone/server.js",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "env:normalize": "node scripts/normalize-env-local.mjs",
    "reel:studio": "remotion studio remotion/index.tsx",
    "reel:render": "node scripts/render-reel.mjs",
    "reel:lambda:deploy": "node scripts/remotion-lambda-deploy.mjs",
    "reel:lambda:render": "node scripts/render-reel-lambda.mjs",
